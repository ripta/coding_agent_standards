{
  "_disabled": [
    {
      "_note": "DISABLED: `make lint` on `git commit`. Blocks commits in projects without a Makefile/`lint` target. To re-enable, move this object (without `_note`) into `hooks.PreToolUse`.",
      "matcher": "Bash(git commit*)",
      "hooks": [
        {
          "type": "command",
          "command": "make lint"
        }
      ]
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/block-broad-find.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "make fmt 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: run make test lint before considering work complete'"
          }
        ]
      }
    ]
  }
}

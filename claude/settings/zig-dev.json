{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(zig build *)",
      "Bash(zig test *)",
      "Bash(zig fmt *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/coding_agent_standards/claude/hooks/block-zig-cache.sh"
          }
        ]
      }
    ]
  }
}

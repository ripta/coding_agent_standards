#!/usr/bin/env python3
"""Build a standalone Codex plugin in dist/codex; never install user config."""

import hashlib
import json
import re
import runpy
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SOURCE = REPO / "claude"
OUTPUT = REPO / "dist" / "codex"
SKILLS = (
    "format-checker", "gitignore-maintainer", "go-code-reviewer", "lint-runner",
    "makefile-helper", "release", "risk-assessment", "schedule-proposal", "session-report",
    "testing-specialist",
)
COMMANDS = ("next-pr", "summary", "work-on", "work-queue")
ROLES = ("implementer", "reviewer", "adr-impact")
UNSUPPORTED = re.compile(
    r"CLAUDE_[A-Z_]+|\$ARGUMENTS|EnterPlanMode|ExitPlanMode|SendMessage|"
    r"AskUserQuestion|Agent tool|Agent sub-tasks|coding-standards:|"
    r"agent_liveness\.py|TaskStop|<output-file>|Skill tool"
)
translate = runpy.run_path(str(REPO / "codex" / "scripts" / "translate.py"))["translate"]


def baseline_paths():
    paths = []
    for line in (REPO / "profiles" / "baseline.md").read_text().splitlines():
        if not line.startswith("@"):
            continue
        if line.startswith("@~/.claude/coding-standards-current/"):
            relative = line.removeprefix("@~/.claude/coding-standards-current/")
            source = SOURCE / relative
        elif line.startswith("@../practices/"):
            relative = line.removeprefix("@../")
            source = REPO / relative
        else:
            raise ValueError(f"unsupported baseline import: {line}")
        if ".." in Path(relative).parts or not source.is_file():
            raise ValueError(f"invalid baseline import: {line}")
        paths.append(relative)
    if not paths:
        raise ValueError("baseline profile has no imports")
    return paths


def write_baseline(paths):
    for relative in paths:
        target = OUTPUT / relative
        text = target.read_text().replace("AskUserQuestion", "available user-question")
        text = text.replace(" (up to 4 questions)", "")
        text = text.replace("call with `multiSelect`", "call allowing multiple selections")
        text = text.replace("Call ListAgents and look for", "Use available session discovery to look for")
        target.write_text(text)
    (OUTPUT / "baseline.md").write_text(
        "# Coding standards baseline for Codex\n\n"
        "Generated from profiles/baseline.md by bin/build-codex. Do not edit this copy.\n\n"
        "Read and follow every document below before working on the project. Resolve these paths\n"
        "relative to this file, regardless of the project's working directory. These are instructions,\n"
        "not optional background reading. If a document is missing, report it before proceeding.\n\n"
        + "".join(f"- [{path}]({path})\n" for path in paths)
        + "\n## Codex adaptations\n\n"
        "Apply these adaptations when reading the shared standards:\n\n"
        "- Use the available user-question tool within its limits. If unavailable, ask in chat.\n"
        "  For multiple selections, let the user name each approved item in text.\n"
        "- Use the session's shell execution tool when cg_run and cg_run_many are unavailable.\n"
        "  Use its output limits and inspect any truncated output needed for the task.\n"
        "  Follow the session's approval mechanism for commands requiring permission.\n"
        "  A command the user runs outside the session runs in their terminal.\n"
        "- Discover and contact guardians only when the session exposes those capabilities and\n"
        "  authorizes contact. Otherwise report the external defect to the user. Do not spawn a\n"
        "  guardian or assume that listing child agents discovers other sessions.\n"
        "- References to Claude commands, skills, hooks, and the Workflow tool describe their\n"
        "  original integration. This baseline does not install or invoke those integrations.\n"
        "  Their approval exceptions apply only when that workflow is actually available and approved.\n"
        "  No disclosure hook or session-start notice is enabled by reading these standards.\n"
        "- Resolve bundled reference paths against this directory. Project paths belong to the\n"
        "  project being worked on. Run scripts/proposals.py with Python 3.10+ from this bundle when needed.\n"
        "  Preserve existing spec locations, including external directories and symlinks.\n"
    )


def convert_skill(text, name, command=False):
    text = translate(text, name)
    parts = text.split("---\n", 2)
    if len(parts) != 3 or parts[0]:
        raise ValueError(f"{name}: expected YAML frontmatter")
    # Preserve multiline descriptions; reject new metadata rather than silently
    # pretending its Claude behavior is supported.
    fields = re.split(r"(?=^[a-z][a-z-]*:)", parts[1], flags=re.MULTILINE)
    kept = []
    for field in fields:
        if not field.strip():
            continue
        key = field.split(":", 1)[0]
        if key in ("name", "description"):
            kept.append(field)
        elif key not in ("model", "allowed-tools", "argument-hint"):
            raise ValueError(f"{name}: unsupported metadata {key!r}")
    if command:
        kept.insert(0, f"name: {name}\n")
    body = parts[2].replace("${CLAUDE_PLUGIN_ROOT}", "../..")
    body = body.replace("${CLAUDE_SKILL_DIR}", ".")
    body = body.replace("$ARGUMENTS", "the arguments in the user's request")
    preamble = (
        "\nResolve bundled paths relative to this SKILL.md, not the project's working\n"
        "directory. Run project commands in the project being worked on.\n"
    )
    if name == "go-code-reviewer":
        preamble += "Report findings only; do not edit files.\n"
    result = "---\n" + "".join(kept) + "---\n" + preamble + body
    if UNSUPPORTED.search(result):
        raise ValueError(f"{name}: untranslated Claude dependency")
    return result


def convert_role(text, name):
    parts = text.split("---\n", 2)
    if len(parts) != 3 or parts[0]:
        raise ValueError(f"{name}: expected YAML frontmatter")
    body = translate(parts[2], name).replace("${CLAUDE_PLUGIN_ROOT}", "../..")
    result = (f"# {name}\n\nResolve bundled paths relative to this reference file.\n"
              "Run project commands in the checkout named by the coordinator.\n\n" + body)
    if UNSUPPORTED.search(result):
        raise ValueError(f"{name}: untranslated Claude dependency")
    return result


def version_plugin():
    manifests = (".codex-plugin/plugin.json",)
    digest = hashlib.sha256()
    for path in sorted(OUTPUT.rglob("*")):
        if not path.is_file():
            continue
        relative = path.relative_to(OUTPUT).as_posix()
        contents = path.read_bytes()
        if relative in manifests:
            manifest = json.loads(contents)
            manifest["version"] = "0.1.0"
            contents = (json.dumps(manifest, indent=2) + "\n").encode()
        digest.update(relative.encode() + b"\0" + contents + b"\0")
    version = "0.1.0+codex." + digest.hexdigest()[:16]
    for relative in manifests:
        path = OUTPUT / relative
        manifest = json.loads(path.read_text())
        manifest["version"] = version
        path.write_text(json.dumps(manifest, indent=2) + "\n")


def main():
    if len(sys.argv) != 1:
        raise ValueError("usage: bin/build-codex")
    baseline = baseline_paths()
    # Prepare and validate translations before replacing the previous build.
    converted = {}
    for name in (*SKILLS, *COMMANDS):
        source = (SOURCE / "commands" / f"{name}.md" if name in COMMANDS
                  else SOURCE / "skills" / name / "SKILL.md")
        converted[name] = convert_skill(source.read_text(), name, name in COMMANDS)
    roles = {name: convert_role((SOURCE / "agents" / f"{name}.md").read_text(), name)
             for name in ROLES}
    if OUTPUT.is_symlink() or OUTPUT.parent.is_symlink():
        raise ValueError("refusing to build through a symlink at dist/ or dist/codex/")
    if OUTPUT.exists():
        shutil.rmtree(OUTPUT)
    OUTPUT.mkdir(parents=True)
    for name, text in converted.items():
        target = OUTPUT / "skills" / name
        if name in SKILLS:
            shutil.copytree(SOURCE / "skills" / name, target)
        else:
            target.mkdir(parents=True)
        (target / "SKILL.md").write_text(text)
        if name in COMMANDS:
            (target / "agents").mkdir(exist_ok=True)
            (target / "agents" / "openai.yaml").write_text(
                "policy:\n  allow_implicit_invocation: false\n"
            )
    role_directory = OUTPUT / "references" / "agents"
    role_directory.mkdir(parents=True)
    for name, text in roles.items():
        (role_directory / f"{name}.md").write_text(text)
    for directory in ("rules", "project-management", "knowledge"):
        shutil.copytree(SOURCE / directory, OUTPUT / directory)
    # No generated workflow uses the Claude critic/judge orchestration.
    (OUTPUT / "project-management" / "design-convergence.md").unlink()
    # These references describe structured questions without requiring Claude's
    # tool name or its particular question-count limit.
    decisions = OUTPUT / "rules" / "decision-making.md"
    text = decisions.read_text().replace("AskUserQuestion", "available user-question")
    text = text.replace(" (up to 4 questions)", "")
    decisions.write_text(text)
    shutil.copytree(REPO / "practices", OUTPUT / "practices")
    shutil.copytree(REPO / "rumdl", OUTPUT / "rumdl")
    tracking = OUTPUT / "project-management" / "tracking.md"
    tracking.write_text(tracking.read_text().replace("claude/rules/", "rules/"))
    (OUTPUT / "scripts").mkdir()
    shutil.copy2(SOURCE / "scripts" / "proposals.py", OUTPUT / "scripts" / "proposals.py")
    shutil.copy2(SOURCE / "scripts" / "detect_era.py", OUTPUT / "scripts" / "detect_era.py")
    shutil.copy2(REPO / "codex" / "scripts" / "setup.py", OUTPUT / "scripts" / "setup.py")
    shutil.copy2(REPO / "codex" / "scripts" / "verify_hooks.py", OUTPUT / "scripts" / "verify_hooks.py")
    write_baseline(baseline)
    (OUTPUT / "hooks").mkdir()
    for name in ("link-current.py", "check-setup.py"):
        shutil.copy2(REPO / "codex" / "hooks" / name, OUTPUT / "hooks" / name)
    (OUTPUT / "hooks" / "hooks.json").write_text(json.dumps({
        "hooks": {"SessionStart": [{"hooks": [{
            "type": "command",
            "command": 'python3 "${PLUGIN_ROOT}/hooks/check-setup.py"',
            "statusMessage": "Checking coding standards setup",
        }]}]},
    }, indent=2) + "\n")
    (OUTPUT / ".codex-plugin").mkdir()
    (OUTPUT / ".codex-plugin" / "plugin.json").write_text(json.dumps({
        "name": "coding-standards-portable",
        "version": "0.1.0",
        "description": "Shared coding standards and baseline adapted for Codex",
        "author": {"name": "Ripta Pasay"},
        "skills": "./skills/",
        "hooks": "./hooks/hooks.json",
    }, indent=2) + "\n")
    marketplace = OUTPUT / ".agents" / "plugins"
    marketplace.mkdir(parents=True)
    (marketplace / "marketplace.json").write_text(json.dumps({
        "name": "coding-standards-portable",
        "interface": {"displayName": "Portable Coding Standards"},
        "plugins": [{
            "name": "coding-standards-portable",
            "source": {"source": "local", "path": "."},
            "policy": {"installation": "AVAILABLE", "authentication": "ON_INSTALL"},
            "category": "Productivity",
        }],
    }, indent=2) + "\n")
    (OUTPUT / "README.md").write_text(
        "# Generated Codex plugin\n\n"
        "Built by bin/build-codex. Edit claude/ and rebuild.\n\n"
        "For baseline standards, instruct Codex in your AGENTS.md to read and follow\n"
        "~/.codex/coding-standards-current/baseline.md.\n"
        "The trusted SessionStart hook maintains that link to the installed snapshot.\n"
        "Plugin installation alone does not activate the baseline.\n\n"
        "Run scripts/setup.py from the installed snapshot to enable the baseline,\n"
        "or pass --check to report missing setup without changing files.\n"
        "The startup hook checks setup without editing global or project instructions.\n\n"
        "Included skills: " + ", ".join(converted) + ".\n\n"
        "Commands are explicit-only skills. work-queue and work-on use bundled role\n"
        "instructions with ordinary Codex subagents; no custom roles are installed.\n"
        "Run approval happens explicitly in chat. Progress uses update_plan when\n"
        "available, or commentary, with full state kept in session reports.\n"
        "Claude UI mods, settings, and Codex-only skills are not included. Reference documents do not\n"
        "register agents or enable Claude integrations. Model and tool restrictions\n"
        "from Claude frontmatter are not enforced; Codex session permissions apply.\n"
    )
    # Codex caches by version, so all installed files must participate in its identity.
    version_plugin()
    print(f"Built {OUTPUT} ({len(converted)} skills)")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError) as error:
        sys.exit(f"error: {error}")

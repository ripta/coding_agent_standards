#!/usr/bin/env bash
# Builds an OpenCode-compatible copy of a subset of the claude/ plugin into
# opencode/. The output is generated and gitignored. Edit claude/ instead.
#
# Usage: bin/build-opencode [--link]
#   --link  also symlink the generated agents and commands into the OpenCode
#           config directory, under a coding-standards/ namespace
#
# The build fails if a Claude-only token survives translation. That usually
# means a source file changed under one of the file-specific rewrites below.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$REPO/claude"
OUT="$REPO/opencode"
OPENCODE_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"

MODEL_HAIKU=anthropic/claude-haiku-5-5
MODEL_SONNET=anthropic/claude-sonnet-5-5
MODEL_OPUS=anthropic/claude-opus-5-5

AGENTS=(adr-impact implementer reviewer)
COMMANDS=(migrate-era next-pr summary work-on work-queue)
SKILLS=(
  bug-triage
  format-checker
  gitignore-maintainer
  go-code-reviewer
  lint-runner
  makefile-helper
  new-proposal
  open-questions-audit
  proposal-cleanup
  rca
  release
  risk-assessment
  schedule-proposal
  session-report
  testing-specialist
)

LINK=false
for arg in "$@"; do
  case "$arg" in
    --link) LINK=true ;;
    *) echo "usage: $0 [--link]" >&2; exit 2 ;;
  esac
done

# Rewrites frontmatter for one kind of file: agent, command, or skill.
convert_frontmatter() {
  local kind="$1" file="$2"
  awk -v kind="$kind" -v haiku="$MODEL_HAIKU" -v sonnet="$MODEL_SONNET" -v opus="$MODEL_OPUS" '
    NR == 1 && $0 == "---" { fm = 1; print; next }
    fm && $0 == "---" {
      if (kind == "agent") {
        print "mode: subagent"
        perm = ""
        if (tools != "" && tools !~ /Edit|Write/)
          perm = perm "  - action: edit\n    resource: \"*\"\n    effect: deny\n"
        if (tools != "" && tools !~ /Agent/)
          perm = perm "  - action: subagent\n    resource: \"*\"\n    effect: deny\n"
        if (perm != "") printf "permissions:\n%s", perm
      }
      fm = 0; print; next
    }
    fm && /^(allowed-tools|argument-hint):/ { next }
    fm && kind == "agent" && /^name:/ { next }
    fm && kind == "agent" && /^tools:/ { tools = $0; next }
    fm && /^model:/ {
      if (kind == "skill") next
      m = $2
      if (m == "haiku") m = haiku
      else if (m == "sonnet") m = sonnet
      else if (m == "opus" || m == "opusplan") m = opus
      print "model: " m; next
    }
    { print }
  ' "$file" >"$file.tmp"
  mv "$file.tmp" "$file"
}

# Rewrites Claude-specific paths and tool names in the body.
convert_body() {
  local file="$1"
  SRC="$SRC" perl -pi -e '
    s{\$\{CLAUDE_SKILL_DIR\}/\.\./\.\./}{$ENV{SRC}/}g;
    s{\$\{CLAUDE_SKILL_DIR\}}{$ENV{SKILL_DIR}}g if $ENV{SKILL_DIR};
    s{\$\{CLAUDE_PLUGIN_ROOT\}}{$ENV{SRC}}g;
    s{`?\bAskUserQuestion\b`? call}{question tool call}g;
    s{`?\bAskUserQuestion\b`?}{the question tool}g;
    s{\bAgent tool\b}{subagent tool}g;
    s{\bAgent sub-tasks\b}{subagent tasks}g;
    s{\bExplore agents\b}{the explore subagent}g;
    s{coding-standards:}{coding-standards/}g;
  ' "$file"
}

rm -rf "$OUT"
mkdir -p "$OUT/agents" "$OUT/commands" "$OUT/skills"

for name in "${AGENTS[@]}"; do
  file="$OUT/agents/$name.md"
  cp "$SRC/agents/$name.md" "$file"
  convert_frontmatter agent "$file"
  convert_body "$file"
done

for name in "${COMMANDS[@]}"; do
  file="$OUT/commands/$name.md"
  cp "$SRC/commands/$name.md" "$file"
  convert_frontmatter command "$file"
  convert_body "$file"
done

for name in "${SKILLS[@]}"; do
  cp -R "$SRC/skills/$name" "$OUT/skills/$name"
  file="$OUT/skills/$name/SKILL.md"
  convert_frontmatter skill "$file"
  SKILL_DIR="$OUT/skills/$name" convert_body "$file"
  # OpenCode skills take no arguments; the request itself carries them.
  perl -pi -e 's{`?\$ARGUMENTS`?}{the arguments in the user'"'"'s request}g' "$file"
done

# OpenCode has no plan mode tool. Its plan agent cannot edit, so /work-on stays
# in the current agent and holds edits until the plan is approved.
perl -0pi -e '
  s{Start by calling the EnterPlanMode tool.*?plan mode\.\n\nOnce in plan mode, work on}{Plan before you change anything. Do not edit files until the user approves\nthe plan in step 10.\n\nWork on}s;
  s{before you call\s+ExitPlanMode}{before you ask for plan approval}s;
' "$OUT/commands/work-on.md"

# /migrate-era plans the same way, and asks for approval before it edits.
perl -0pi -e '
  s{Start by calling the EnterPlanMode tool.*?plan mode\.\n\n}{Plan before you change anything. Do not edit files until the user approves\nthe plan in step 4.\n\n}s;
  s{ in plan mode, reading and\s+planning only}{, reading and planning only}s;
  s{Call ExitPlanMode\. That approval}{Present the plan and ask the user to approve it with the question tool. That\n   approval}s;
' "$OUT/commands/migrate-era.md"

# /work-queue gets the same plan-then-approve treatment as /work-on. Fix
# rounds continue the implementer's subagent session instead of SendMessage,
# and the wrapped command is the translated /work-on.
SRC="$SRC" OUT="$OUT" perl -0pi -e '
  s{Start by calling the EnterPlanMode tool.*?plan mode\.\n\n}{Plan before you change anything. Do not edit files or commit until the user\napproves the plan at the end of section 1.\n\n}s;
  s{## 1\. Plan mode:}{## 1. Plan:};
  s{before calling\s+ExitPlanMode}{before asking\n   for plan approval}s;
  s{Call ExitPlanMode\. That approval}{Present the plan and ask the user to approve it with the question tool. That\napproval}s;
  s{right after\s+ExitPlanMode\.}{right after\nthe plan is approved.}s;
  s{Its\s+plan mode and plan approval}{Its\nplanning and plan approval}s;
  s{Do not schedule in plan mode\.\s+Plan mode\s+cannot write, and scheduling}{Do not schedule while planning. The plan holds\nedits until it is approved, and scheduling}s;
  s{call ExitPlanMode with a plan that implements nothing\.}{present a plan that implements nothing, and ask the user to approve it with\nthe question tool.}s;
  s{Approving it only leaves plan mode, so\s+`/schedule-proposal` can write\.}{Approving it only lets `/schedule-proposal`\nwrite.}s;
  s{call EnterPlanMode and start section 1 again}{start section 1 again}s;
  s{Do not re-enter plan mode, and do not present a}{Do not plan again, and do not present a}s;
  s{with SendMessage,\s+so it keeps its context\.}{through the\n   subagent tool, passing its sessionID, so it keeps its context.}s;
  s{once with SendMessage\.}{once through the subagent tool, passing its\n   sessionID.}s;
  s{stop it with TaskStop\.\s+Stopping an agent also kills every background command it started\.\s+Never\s+stop one}{abandon it.\n   Never abandon one}s;
  s{[ \t]*<!-- Workaround for bugs/20261005.*?\n\n}{}s;
  s{\Q$ENV{SRC}\E/commands/work-on\.md}{$ENV{OUT}/commands/work-on.md}g;
' "$OUT/commands/work-queue.md"

# The SendMessage fallback works around a Claude Code bug and has no OpenCode
# equivalent.
perl -ni -e 'print unless /Workaround for bugs\/20261005|SendMessage/' "$OUT/agents/implementer.md"

leftovers="$(grep -rnE 'CLAUDE_[A-Z_]+|EnterPlanMode|ExitPlanMode|SendMessage|TaskStop|[Pp]lan mode|AskUserQuestion|Agent tool|Agent sub-tasks|coding-standards:' \
  --include='*.md' "$OUT" || true)"
if [ -n "$leftovers" ]; then
  echo "error: Claude-only references survived translation:" >&2
  echo "$leftovers" >&2
  exit 1
fi

echo "Built $OUT"

if [ "$LINK" = true ]; then
  for kind in agents commands; do
    dst="$OPENCODE_CONFIG/$kind/coding-standards"
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
      echo "error: $dst exists and is not a symlink" >&2
      exit 1
    fi
    ln -sfn "$OUT/$kind" "$dst"
    echo "Linked $dst"
  done
fi

#!/usr/bin/env python3
"""Build and install the standards plugin and enable its baseline for local projects."""

import json
import os
import subprocess
import sys
from pathlib import Path


REPO = Path(__file__).resolve().parent.parent


def main():
    if len(sys.argv) != 1:
        raise ValueError("usage: bin/install-codex")
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex")).expanduser().resolve()
    instructions = codex_home / "AGENTS.md"
    baseline = codex_home / "coding-standards-current" / "baseline.md"
    block = (
        "## Shared coding standards\n\n"
        f"Read and follow `{baseline}`, including every document it lists,\n"
        "before working on any project. If the file is missing, report the missing standards\n"
        "and repair the plugin installation before proceeding.\n"
    )
    subprocess.run([sys.executable, str(REPO / "bin" / "build-codex")], check=True)
    subprocess.run([
        "codex", "plugin", "marketplace", "add", str(REPO / "dist" / "codex"),
    ], check=True)
    result = subprocess.run([
        "codex", "plugin", "add", "coding-standards-portable@coding-standards-portable", "--json",
    ], check=True, capture_output=True, text=True)
    installed = Path(json.loads(result.stdout)["installedPath"])
    subprocess.run([
        sys.executable, str(installed / "hooks" / "link-current.py"),
    ], check=True, env=dict(os.environ, PLUGIN_ROOT=str(installed), CODEX_HOME=str(codex_home)))
    # Append only; existing global instructions belong to the user.
    with instructions.open("a+") as stream:
        stream.seek(0)
        existing = stream.read()
        if str(baseline) not in existing and "~/.codex/coding-standards-current/baseline.md" not in existing:
            stream.write(("\n\n" if existing else "") + block)
    print(f"Installed {installed}")
    print(f"Baseline enabled in {instructions}")
    print("Start a new thread. Review and trust the plugin's SessionStart hook in Codex")
    print("to refresh the stable link automatically after future plugin updates.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f"error: {error}")

#!/usr/bin/env bash
#
# Runs rumdl over markdown files.
#
# The default mode lints only files changed against a base ref. Most repos carry
# a backlog of pre-existing findings. Diff scoping keeps the signal on new work.
# Use --all for a full-tree report. Do not gate CI on --all.
#
# Adopting the 120-column setting is cheap here in a way it is not for Vale:
# MD013 carries a fix, so `lint-markdown --all --fix` clears the backlog in one
# pass. Run that once at adoption, then leave the default diff scoping in place.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: lint-markdown [options]

  (no options)     lint files changed against the base ref
  --all            lint the whole tree (report only, not a gate)
  --fix            rewrite files in place instead of reporting
  --base <ref>     compare against an explicit ref
  --staged         lint staged files only
  -h, --help       show this message
EOF
}

MODE="diff"
BASE=""
FIX=""

while [ $# -gt 0 ]; do
  case "$1" in
    --all) MODE="all"; shift ;;
    --staged) MODE="staged"; shift ;;
    --fix) FIX="--fix"; shift ;;
    --base) BASE="${2:?--base needs a ref}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "lint-markdown: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if ! command -v rumdl >/dev/null 2>&1; then
  echo "lint-markdown: rumdl not found. Install it with 'brew install rumdl'." >&2
  exit 127
fi

# git reports repo-relative paths, so run everything from the repo root. This
# also makes the tool work when invoked from a subdirectory.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  echo "lint-markdown: not inside a git repository." >&2
  exit 2
fi
cd "$ROOT"

# rumdl discovers .rumdl.toml on its own. Without one it silently falls back to
# built-in defaults, where MD013 is 80 rather than the 120 this repo standardizes
# on, so a missing config reads as a clean repo with the wrong width.
if [ ! -f .rumdl.toml ]; then
  echo "lint-markdown: no .rumdl.toml at $ROOT." >&2
  echo "  Copy it from coding_agent_standards/rumdl/rumdl.toml.template." >&2
  exit 2
fi

if [ "$MODE" = "all" ]; then
  exec rumdl check . ${FIX:+"$FIX"}
fi

# --- Resolve the base ref ---
if [ -z "$BASE" ]; then
  for candidate in origin/main origin/master main master; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null; then
      BASE="$candidate"
      break
    fi
  done
fi

if [ -z "$BASE" ]; then
  echo "lint-markdown: could not resolve a base ref. Pass --base <ref>." >&2
  exit 2
fi

# --- Collect changed files ---
if [ "$MODE" = "staged" ]; then
  CHANGED="$(git diff --cached --name-only --diff-filter=d)"
else
  MERGE_BASE="$(git merge-base HEAD "$BASE" 2>/dev/null || echo "$BASE")"
  # Compares the working tree to the merge base, so committed and uncommitted
  # changes are both covered. Untracked files are added separately.
  CHANGED="$(git diff --name-only --diff-filter=d "$MERGE_BASE"
             git ls-files --others --exclude-standard)"
fi

# Drop blanks, dedupe, keep only markdown that still exists.
FILES=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue
  case "$f" in
    *.md|*.markdown) FILES+=("$f") ;;
  esac
done < <(printf '%s\n' "$CHANGED" | sort -u)

if [ ${#FILES[@]} -eq 0 ]; then
  echo "lint-markdown: no changed markdown files against $BASE."
  exit 0
fi

exec rumdl check ${FIX:+"$FIX"} "${FILES[@]}"

# rumdl configuration for projects following coding_agent_standards.
#
# Copy this file to .rumdl.toml at the repo root. rumdl discovers that name on
# its own, so no flag is needed:
#
#   cp ~/projects/coding_agent_standards/rumdl/rumdl.toml.template .rumdl.toml
#
# rumdl has no config inheritance. Passing `--config <path>` REPLACES the
# discovered .rumdl.toml rather than merging with it, so a symlink back to this
# template would silently drop a project's own per-file-ignores. Each project
# keeps a real copy and re-syncs by hand when this template changes.
#
# Only deviations from the defaults belong here. Run `rumdl config --defaults`
# to see the baseline, and `rumdl config --no-defaults` to see what this file
# actually changes.

[MD013]
# Markdown prose wraps at 120, per the Markdown Quality section of
# claude/project-management/tracking.md.
#
# Code and code comments wrap at 100. That is a different number for a
# different domain, enforced by each language's formatter rather than by rumdl.
# See claude/rules/work-discipline.md. Do not reconcile the two.
line-length = 120

# Code blocks carry the width of the language they are written in. Holding a Go
# snippet to a markdown limit would fight gofmt, so they are exempt. Tables are
# already exempt by default and stay that way; a column cannot be wrapped
# without breaking the table.
code-blocks = false

# Reflow lets `rumdl fmt` rewrap over-long paragraphs, which turns adoption into
# one command instead of a manual pass over every finding.
#
# It only rewraps paragraphs that contain a violation. Paragraphs already under
# the limit are left byte-for-byte alone, so a file hand-wrapped at 80 stays
# hand-wrapped at 80.
#
# Turn this off in a project that uses semantic line breaks, where one sentence
# per line is deliberate and joining them up to 120 would destroy the intent.
reflow = true

[per-file-ignores]
# Skill and agent definitions carry their title in YAML frontmatter as `name:`,
# and their body starts at `##` by convention. They have no h1 and should not
# grow one -- the frontmatter is the contract the harness reads.
#
# Commands are the same shape for a different reason. Their frontmatter carries
# `description:`, and their body is the prompt text sent to the model. An h1
# added to satisfy the rule would become part of that prompt.
#
# MD041 has no setting that models this. `front-matter-title` is accepted but
# does not treat `name:` as satisfying the rule, and `allow-preamble = true`
# only relocates the complaint to the first `##`. So the rule is ignored for
# these paths rather than weakened everywhere.
#
# Drop the entries a project does not have. MD041 should stay on for ordinary
# prose docs, which do open with an h1.
"**/SKILL.md" = ["MD041"]
".claude/agents/*.md" = ["MD041"]
".claude/commands/*.md" = ["MD041"]
